# ==============================================================================
# LKL Website — Environment Variables Template
# ==============================================================================
# Do not commit real production secrets into version control.
# Copy this file to .env.local for local development.

# --- Application Configuration ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Business Details (Defaults) ---
NEXT_PUBLIC_BUSINESS_NAME="شركة لبيب كمال للأدوات والآلات الزراعية"
NEXT_PUBLIC_BRAND_NAME="LKL"
NEXT_PUBLIC_BUSINESS_SLOGAN="الجودة • الثقة • الخدمة المتميزة"
NEXT_PUBLIC_BUSINESS_LOCATION="الزقازيق — الشرقية — مصر"
NEXT_PUBLIC_BUSINESS_ADDRESS_PHRASE="البداية، طريق مصر الزراعي"
NEXT_PUBLIC_BUSINESS_PHONE=""
NEXT_PUBLIC_BUSINESS_WHATSAPP=""

# --- Database Connection (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/lkl_db

# --- Authentication (Google OAuth & Sessions) ---
AUTH_SECRET=generate-a-secure-32-byte-hex-secret-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Administrative Access ---
# Comma-separated list of pre-authorized admin Google account emails
ADMIN_EMAILS=admin@example.com
